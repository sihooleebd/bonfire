# Example flake.nix for a NixOS configuration using Bonfire NixOS modules.
# This flake.nix file using ONLINE remote to fetch Bonfire NixOS modules from GitHub

{
  description = "System Configuration powered by Bonfire NixOS";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-26.05";
    bonfire = {
      url = "github:sihooleebd/bonfire?dir=nix";
    	inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, bonfire, ... }@inputs: {
    nixosConfigurations = {

    	# Change "nixos" to your hostname or leave it for default
    	nixos = nixpkgs.lib.nixosSystem {
      	system = "x86_64-linux";
                
      	modules = [
        	./hardware-configuration.nix
        	./configuration.nix
        	bonfire.nixosModules.default
      	];
    	};
  	};
  };
}